APP_NAME=Cyber Workbench API
APP_ENV=development
API_PREFIX=/api
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Projet Supabase de test ; laisser vide pour les outils publics locaux.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Uniquement serveur, nécessaire pour paiements et suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_PUBLIC_PATHS=/,/health,/docs,/redoc,/openapi.json,/tools/osint,/api/tools/osint,/api/billing/webhooks
# Aucune connexion directe de secours lorsqu'un proxy est demandé.
RESIDENTIAL_PROXY_URL=
DOH_PROVIDER_URL=https://cloudflare-dns.com/dns-query
REDIS_URL=redis://127.0.0.1:6379/0
# Paiements explicitement désactivés. Ne pas activer avant les essais de test.
BILLING_ENABLED=false
BILLING_TEST_MODE=true
BILLING_PUBLIC_URL=
PRO_PRICE=0
ELITE_PRICE=0
LEMON_API_KEY=
LEMON_STORE=
LEMON_PRO_VARIANT=
LEMON_ELITE_VARIANT=
LEMON_WEBHOOK_SECRET=
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE=
BTCPAY_WEBHOOK_SECRET=
NOWPAYMENTS_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_WEBHOOK_SECRET=

# --- Développement uniquement ---
# Force l'entitlement local (pro|elite) sans compte payant. Ignoré si APP_ENV != development.
# DEV_FORCE_TIER=elite

# Tor (routage DNS Lookup) — client SOCKS uniquement. Vide = Tor désactivé.
# Local direct : socks5h://127.0.0.1:9050  |  via docker-compose.tor.yml : socks5h://tor:9050
TOR_SOCKS_URL=
TOR_DOH_TIMEOUT=20
TOR_MAX_RESPONSE_BYTES=65536

# Composant DNS-Tor isolé (le backend/worker l'appellent ; ils ne font jamais de Tor).
# En profil docker-compose.tor.yml : http://tor_dns_executor:8070
TOR_EXECUTOR_URL=
TOR_EXECUTOR_TOKEN=
TOR_EXECUTOR_TIMEOUT=55
